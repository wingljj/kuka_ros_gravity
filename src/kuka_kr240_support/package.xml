<?xml version="1.0"?>
<package format="2">
  <name>kuka_kr240_support</name>
  <version>0.1.0</version>
  <description>
    ROS-Industrial support for the KUKA KR 240 R3330 manipulator.
  </description>

  <author>KUKA ROS-Industrial Contributors</author>
  <maintainer email="user@example.com">KUKA ROS-Industrial Contributors</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <test_depend>roslaunch</test_depend>

  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>kuka_eki_hw_interface</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <architecture_independent/>
  </export>
</package>
