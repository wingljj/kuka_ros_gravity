<launch>
  <node name="collect_load_profile_server" pkg="tool_gravity_compensation"
        type="collect_load_profile_server" output="screen">
    <param name="wrench_topic" value="/sri_ft_sensor/wrench"/>
    <param name="sensor_frame" value="sri_ft_sensor"/>
    <param name="base_frame" value="base_link"/>
    <param name="move_group" value="manipulator"/>
    <param name="sampling/filter_window_size" value="10"/>
    <param name="sampling/max_stddev_force" value="0.001"/>
    <param name="sampling/max_stddev_torque" value="0.001"/>
    <param name="sampling/min_stable_samples" value="10"/>
    <param name="sampling/sample_timeout" value="1.0"/>
  </node>

  <test test-name="test_collect_load_profile_positive"
        pkg="tool_gravity_compensation"
        type="test_collect_load_profile_positive.py"
        time-limit="20.0"/>
</launch>
